// use prisma-8
// Contract inferred from the live database schema. Edit as needed, then run `prisma contract emit`.

model MedicalSpecialties {
  id               BigInt    @id(map: "medical_specialties_pkey") @default(autoincrement())
  medicalSpecialty VarChar   @unique(map: "medical_specialties_specialty_name_key") @map("medical_specialty")
  accessFrequency  BigInt    @default(0) @map("access_frequency")
  doctors          Doctors[]

  @@rls
  @@map("medical_specialties")
}

model Users {
  id                SmallInt    @id(map: "users_pkey") @default(autoincrement())
  createdAt         Timestamptz @default(now()) @map("created_at")
  email             VarChar     @unique(map: "users_email_key")
  role              String      @default("patient")
  name              VarChar
  cpf               VarChar     @unique(map: "users_cpf_key")
  birthday          Date
  photo             String?
  stateAddress      VarChar     @map("state_address")
  city              VarChar?
  phoneNumber       VarChar     @unique(map: "users_phone_number_key") @map("phone_number")
  gender            VarChar?
  passwordEncrypted VarChar     @map("password_encrypted")
  doctors           Doctors[]
  patients          Patients?
  authTokens        AuthTokens[]

  @@rls
  @@map("users")
}

model AuthTokens {
  id        BigInt    @id(map: "auth_tokens_pkey") @default(autoincrement())
  createdAt Timestamptz @default(now()) @map("created_at")
  expiresAt Timestamptz @map("expires_at")
  tokenHash VarChar    @unique(map: "auth_tokens_token_hash_key") @map("token_hash")
  userId    SmallInt   @map("user_id")
  user      Users      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "auth_tokens_user_id_fkey")

  @@index([userId, expiresAt], map: "auth_tokens_user_expiry_idx")
  @@rls
  @@map("auth_tokens")
}

model Doctors {
  id                 SmallInt      @id(map: "doctor_pkey") @default(autoincrement())
  createdAt          Timestamptz   @default(now()) @map("created_at")
  crmUf              VarChar       @map("crm_uf")
  crmNumber          VarChar       @unique(map: "doctor_crm_number_key") @map("crm_number")
  experienceTime     VarChar?      @map("experience_time")
  street             VarChar
  addressNumber      SmallInt      @map("address_number")
  addressComplement  VarChar?      @map("address_complement")
  appointmentPrice   Real?         @map("appointment_price")
  description        VarChar?
  remoteAppointments Boolean       @default(true) @map("remote_appointments")
  userId             SmallInt      @map("user_id")
  insurances         SmallInt[]?   @noCheck(elementNotNull)
  specialty          String?
  appointments       Appointments?
  answers            Answers[]
  medicalSpecialties MedicalSpecialties? @relation(fields: [specialty], references: [medicalSpecialty], onDelete: SetNull, onUpdate: Cascade, map: "doctors_specialty_fkey", index: false)
  user               Users         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "doctors_user_id_fkey", index: false)

  @@rls
  @@map("doctors")
}

model Insurances {
  id        SmallInt    @id(map: "insurances_pkey") @default(autoincrement())
  createdAt Timestamptz @default(now()) @map("created_at")
  name      VarChar     @unique(map: "insurances_name_key")
  patients  Patients[]

  @@rls
  @@map("insurances")
}

model Patients {
  id             SmallInt        @id(map: "patient_pkey") @default(autoincrement())
  createdAt      Timestamptz     @default(now()) @map("created_at")
  insurance      SmallInt?
  userId         SmallInt        @unique(map: "patient_user_id_key") @map("user_id")
  appointments   Appointments?
  medicalRecords MedicalRecords?
  insurances     Insurances?     @relation(fields: [insurance], references: [id], map: "patients_insurance_fkey", index: false)
  user           Users           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "patients_user_id_fkey")

  @@rls
  @@map("patients")
}

model Appointments {
  id          SmallInt    @id(map: "appointments_pkey") @default(autoincrement())
  createdAt   Timestamptz @default(now()) @map("created_at")
  doctorId    SmallInt    @unique(map: "appointments_doctor_id_key") @map("doctor_id")
  patientId   SmallInt?   @unique(map: "appointments_patient_id_key") @map("patient_id")
  date        Date
  startTime   Time        @map("start_time")
  endTime     Time        @map("end_time")
  rate        SmallInt?
  observation VarChar?
  doctor      Doctors     @relation(fields: [doctorId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "appointments_doctor_id_fkey")
  patient     Patients?   @relation(fields: [patientId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "appointments_patient_id_fkey")

  @@rls
  @@map("appointments")
}

model MedicalRecords {
  id            SmallInt    @id(map: "medical_records_pkey") @default(autoincrement())
  createdAt     Timestamptz @default(now()) @map("created_at")
  patientId     SmallInt    @unique(map: "medical_records_patient_id_key") @map("patient_id")
  weight        SmallInt?
  height        SmallInt?
  skinColor     VarChar?    @map("skin_color")
  heartDisease  Boolean?    @map("heart_disease")
  diabetes      Boolean?
  smoker        Boolean?
  cancerHistory Boolean?    @map("cancer_history")
  drinker       Boolean?
  disabilities  Boolean?
  allergies     VarChar[]?  @noCheck(elementNotNull)
  medicines     VarChar[]?  @noCheck(elementNotNull)
  observations  VarChar?
  patient       Patients    @relation(fields: [patientId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "medical_records_patient_id_fkey")

  @@rls
  @@map("medical_records")
}

model PrismaMigrations {
  id                VarChar(36)  @id(map: "_prisma_migrations_pkey")
  checksum          VarChar(64)
  finishedAt        Timestamptz? @map("finished_at")
  migrationName     VarChar(255) @map("migration_name")
  logs              String?
  rolledBackAt      Timestamptz? @map("rolled_back_at")
  startedAt         Timestamptz  @default(now()) @map("started_at")
  appliedStepsCount Int          @default(0) @map("applied_steps_count")

  @@map("_prisma_migrations")
}

model Questions {
  id        Int         @id(map: "questions_pkey") @default(autoincrement())
  question  String
  createdAt Timestamptz @default(now()) @map("created_at")
  answers   Answers[]

  @@index([createdAt, id], map: "questions_created_at_id_idx")
  @@rls
  @@map("questions")
}

model Answers {
  id         Int         @id(map: "answers_pkey") @default(autoincrement())
  questionId Int         @map("question_id")
  doctorId   SmallInt    @map("doctor_id")
  answer     String
  createdAt  Timestamptz @default(now()) @map("created_at")
  question   Questions   @relation(fields: [questionId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "answers_question_id_fkey")
  doctor     Doctors     @relation(fields: [doctorId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "answers_doctor_id_fkey")

  @@unique([questionId, doctorId], map: "answers_question_doctor_key")
  @@index([questionId, createdAt], map: "answers_question_created_at_idx")
  @@index([doctorId], map: "answers_doctor_id_idx")
  @@rls
  @@map("answers")
}
